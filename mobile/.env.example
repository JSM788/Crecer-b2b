# Public build-time values: never put credentials or secrets here.
EXPO_PUBLIC_APP_NAME=Aquamundo
EXPO_PUBLIC_ENVIRONMENT=local
# Native only: API origin; company and role are resolved after credential validation.
# Expo Go on the same LAN can use a private IPv4 HTTP origin in development.
# Use this computer's LAN IP, not the phone's localhost. Release builds require HTTPS.
# EXPO_PUBLIC_API_URL=https://api.example.com
# Exported web preview uses its same-origin HttpOnly BFF instead.
# FRONTEND_ORIGIN=http://127.0.0.1:3001
# PORT=8081
