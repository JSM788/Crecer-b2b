generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Company {
  accessEvents         AccessEvent[]
  id                   String               @id @default(uuid()) @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  invitations          Invitation[]
  slug                 String               @unique
  name                 String
  timeZone             String               @default("UTC") @map("time_zone")
  status               String               @default("active")
  suspendedAt          DateTime?            @map("suspended_at") @db.Timestamptz(6)
  memberships          Membership[]
  customers            Customer[]
  domains              CompanyDomain[]
  platformAuditEntries PlatformAuditEntry[]

  @@index([createdAt(sort: Desc), id])
  @@map("companies")
}

model User {
  activatedAt           DateTime?               @map("activated_at") @db.Timestamptz(6)
  passwordChangedAt     DateTime?               @map("password_changed_at") @db.Timestamptz(6)
  accessEvents          AccessEvent[]           @relation("AccessSubject")
  performedAccessEvents AccessEvent[]           @relation("AccessActor")
  id                    String                  @id @default(uuid()) @db.Uuid
  email                 String                  @unique
  passwordHash          String?                 @map("password_hash")
  failures              Int                     @default(0)
  blockedUntil          DateTime?               @map("blocked_until") @db.Timestamptz(6)
  memberships           Membership[]
  displayName           String?                 @map("display_name")
  phone                 String?                 @db.VarChar(16)
  isPlatformOwner       Boolean                 @default(false) @map("is_platform_owner")
  platformVersion       Int                     @default(0) @map("platform_version")
  platformSessions      PlatformSession[]
  platformOperations    PlatformOperation[]
  platformAuditEntries  PlatformAuditEntry[]
  createdInvitations    Invitation[]
  changedRoleHistory    MembershipRoleHistory[]

  @@map("users")
}

model CompanyDomain {
  hostname  String  @id
  companyId String  @map("company_id") @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId])
  @@map("company_domains")
}

model PlatformAuditEntry {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  action      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, createdAt])
  @@map("platform_audit_log")
}

model Membership {
  accessEvents             AccessEvent[]
  id                       String                  @id @default(uuid()) @db.Uuid
  companyId                String                  @map("company_id") @db.Uuid
  userId                   String                  @map("user_id") @db.Uuid
  active                   Boolean                 @default(true)
  role                     String
  canManageCustomers       Boolean                 @default(false) @map("can_manage_customers")
  canManageFieldOperations Boolean                 @default(false) @map("can_manage_field_operations")
  transitionVersion        Int                     @default(0) @map("transition_version")
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  invitations              Invitation[]
  roleHistory              MembershipRoleHistory[]
  company                  Company                 @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                     User                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions                 Session[]
  customerAssignments      CustomerAssignment[]
  workdays                 Workday[]
  visits                   Visit[]
  operations               Operation[]
  auditEntries             AuditEntry[]

  @@unique([companyId, userId])
  @@unique([companyId, id])
  @@index([companyId, createdAt(sort: Desc), id])
  @@map("memberships")
}

model Session {
  tokenHash    String     @id @map("token_hash")
  companyId    String     @map("company_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sessions")
}

model PlatformSession {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_sessions")
}

model PlatformOperation {
  actorUserId String   @map("actor_user_id") @db.Uuid
  key         String
  fingerprint String
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: NoAction)

  @@id([actorUserId, key])
  @@map("platform_operations")
}

model Customer {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String               @map("company_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  name              String
  address           String
  ruc               String?
  district          String?
  zone              String?
  latitude          Float?
  longitude         Float?
  assignmentVersion Int                  @default(0) @map("assignment_version")
  company           Company              @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments       CustomerAssignment[]
  visits            Visit[]

  @@unique([companyId, id])
  @@unique([companyId, ruc], map: "customers_company_ruc")
  @@index([companyId, createdAt])
  @@map("customers")
}

model CustomerAssignment {
  companyId    String     @map("company_id") @db.Uuid
  customerId   String     @map("customer_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  customer     Customer   @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  membership   Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, customerId, membershipId])
  @@index([companyId, membershipId], map: "customers_owner")
  @@map("customer_assignments")
}

model Workday {
  id           String     @id @default(uuid()) @db.Uuid
  role         String?
  companyId    String     @map("company_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  status       String     @default("active")
  startedAt    DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime?  @map("ended_at") @db.Timestamptz(6)
  businessDate DateTime   @map("business_date") @db.Date
  membership   Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  visits       Visit[]

  @@unique([companyId, id])
  @@unique([companyId, membershipId, businessDate])
  @@unique([companyId, membershipId], where: { status: "active" }, map: "one_active_day")
  @@map("workdays")
}

model Visit {
  id                 String          @id @default(uuid()) @db.Uuid
  plannedRole        String?         @map("planned_role")
  executionRole      String?         @map("execution_role")
  version            Int             @default(0)
  stopOrder          Int?            @map("stop_order")
  cancelledAt        DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?         @map("cancellation_reason")
  companyId          String          @map("company_id") @db.Uuid
  membershipId       String          @map("membership_id") @db.Uuid
  customerId         String          @map("customer_id") @db.Uuid
  scheduledAt        DateTime        @map("scheduled_at") @db.Timestamptz(6)
  workdayId          String?         @map("workday_id") @db.Uuid
  status             String          @default("pending")
  arrivedAt          DateTime?       @map("arrived_at") @db.Timestamptz(6)
  endedAt            DateTime?       @map("ended_at") @db.Timestamptz(6)
  result             String?
  observations       String?
  audit              Json?
  membership         Membership      @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  customer           Customer        @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  workday            Workday?        @relation(fields: [companyId, workdayId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  evidence           VisitEvidence[]

  @@unique([companyId, id])
  @@unique([companyId, membershipId, id], map: "visits_evidence_owner")
  @@unique([companyId, membershipId], where: { status: "active" }, map: "one_active_visit")
  @@index([companyId, membershipId, scheduledAt, id], map: "visits_agenda")
  @@map("visits")
}

model VisitEvidence {
  companyId    String   @map("company_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  visitId      String   @map("visit_id") @db.Uuid
  mimeType     String   @map("mime_type")
  content      Bytes
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  visit        Visit    @relation(fields: [companyId, membershipId, visitId], references: [companyId, membershipId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, visitId])
  @@map("visit_evidence")
}

model Operation {
  companyId    String     @map("company_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  key          String
  fingerprint  String
  response     Json
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([companyId, membershipId, key])
  @@map("operations")
}

model AuditEntry {
  id           BigInt     @id @default(autoincrement())
  companyId    String     @map("company_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  action       String
  details      Json?
  subjectId    String     @map("subject_id") @db.Uuid
  recordedAt   DateTime   @default(now()) @map("recorded_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)

  @@map("audit_log")
}

model MembershipRoleHistory {
  id              String     @id @default(uuid()) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  membershipId    String     @map("membership_id") @db.Uuid
  previousRole    String     @map("previous_role")
  role            String
  changedAt       DateTime   @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedByUserId String     @map("changed_by_user_id") @db.Uuid
  membership      Membership @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  changedBy       User       @relation(fields: [changedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, membershipId, changedAt])
  @@map("membership_role_history")
}

model Invitation {
  purpose         String        @default("activation")
  accessEvents    AccessEvent[]
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  membershipId    String        @map("membership_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash")
  tokenCiphertext String?       @map("token_ciphertext")
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime?     @map("consumed_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  membership      Membership    @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User          @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  outbox          MailOutbox?

  @@index([companyId, membershipId, createdAt])
  @@map("invitations")
}

model MailOutbox {
  id            String     @id @default(uuid()) @db.Uuid
  invitationId  String     @unique @map("invitation_id") @db.Uuid
  status        String     @default("pending")
  attempts      Int        @default(0)
  nextAttemptAt DateTime   @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedUntil   DateTime?  @map("locked_until") @db.Timestamptz(6)
  claimToken    String?    @map("claim_token")
  lastError     String?    @map("last_error")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt        DateTime?  @map("sent_at") @db.Timestamptz(6)
  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, nextAttemptAt])
  @@map("mail_outbox")
}

model AccessEvent {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  companyId    String?     @map("company_id") @db.Uuid
  membershipId String?     @map("membership_id") @db.Uuid
  invitationId String?     @map("invitation_id") @db.Uuid
  actorUserId  String?     @map("actor_user_id") @db.Uuid
  event        String
  outcome      String?
  occurredAt   DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  details      Json?
  user         User?       @relation("AccessSubject", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor        User?       @relation("AccessActor", fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company      Company?    @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membership   Membership? @relation(fields: [companyId, membershipId], references: [companyId, id], onDelete: NoAction, onUpdate: NoAction)
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, membershipId, occurredAt, id])
  @@index([invitationId, occurredAt])
  @@map("access_events")
}
