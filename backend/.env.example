# Local development only. Replace credentials and keep .env private.
DATABASE_URL=postgresql://salinas:local-development-only@localhost:5433/salinas
HOST=127.0.0.1
PORT=3002
TENANT_DOMAINS=[{"host":"localhost","company":"your-company-slug"},{"host":"127.0.0.1","company":"your-company-slug"}]
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
SESSION_TTL_HOURS=168
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_TRANSACTION_ATTEMPTS=3
# Local inbox only: docker compose up -d mailpit, then open http://localhost:8025.
# Production SMTP requires TLS and the real sender/provider credentials.
MAIL_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM=no-reply@example.test
# SMTP_USER and SMTP_PASSWORD must either both be set or both omitted.
WEB_PUBLIC_URL=http://localhost:3001
MOBILE_APP_SCHEME=aquamundo-demo
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key stable: queued invitation tokens depend on it.
MAIL_ENCRYPTION_KEY=
INVITATION_TTL_HOURS=48
MAIL_WORKER_INTERVAL_MS=15000
MAIL_MAX_ATTEMPTS=5
# Tests only accept local PostgreSQL and create/drop their own test_<uuid> schemas.
# TEST_DATABASE_URL may override DATABASE_URL for an independent local test database.
